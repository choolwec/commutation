# Copy this file to `.env.local` and fill in the two values.
# Supabase dashboard → your project → Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# NOT needed for Stage 1, and must never be prefixed NEXT_PUBLIC_.
# Stage 2 uses it server-side to release survey answers during a live round.
# SUPABASE_SERVICE_ROLE_KEY=
